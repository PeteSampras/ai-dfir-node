# Copy to .env.minimal and fill in. Never commit .env.minimal itself (real credentials).

# Filename of the GGUF you've placed in ./models/ -- e.g. if you copied
# muse-glimmer-30b-q4_k_m.gguf into ./models/, set it here.
MODEL_FILE=muse-glimmer-30b-q4_k_m.gguf

# Must match (or be below) the context length the GGUF was actually converted/trained
# for -- 32768 matches the production node's own setting (ansible/group_vars/all.yml.example).
MODEL_CONTEXT_SIZE=32768

# Elasticsearch MCP -- leave blank and drop the "elasticsearch" entry from
# docker/mcpo-config.json if you don't have Elastic reachable from here yet.
ES_URL=https://es.your-soc.example:9200
ES_API_KEY=CHANGEME

# REQUIRED when Elasticsearch uses a self-signed cert (Security Onion default):
# without it the MCP server errors "unable to verify the first certificate".
# Production alternative: ES_CA_CERT=/path/to/ca.crt (validates properly via the cert SAN).
ES_SSL_SKIP_VERIFY=false
