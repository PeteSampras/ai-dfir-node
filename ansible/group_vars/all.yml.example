---
# Copy to group_vars/ainode_production.yml (gitignored) and fill in real
# values. MUST be named to match inventory/production.ini's group name
# ([ainode_production]) exactly -- Ansible only auto-loads a group_vars
# file whose name matches a real inventory group, and "production.yml"
# (no ainode_ prefix) silently never loads for that group. Same bug class
# already hit and fixed once for the test inventory (group_vars/test.yml
# -> ainode_test.yml, matching [ainode_test]) -- don't reintroduce it here.
gpu_available: true
elasticsearch_configured: true
arkime_configured: true
air_gapped: false   # flip true once the enclave has its own DNS/NTP

elasticsearch_url: "https://es.your-soc.example:9200"
elasticsearch_api_key: "CHANGEME"          # read-only key scoped to zeek/sysmon/suricata/logstash indices

arkime_base_url: "https://arkime.your-soc.example"
arkime_api_token: "CHANGEME"               # view-only account

model_repo: "unsloth/muse-glimmer-GGUF"    # confirm exact repo name at build time
model_file: "muse-glimmer.Q5_K_M.gguf"
model_context_size: 32768
# Already downloaded the GGUF? Point at it and Ansible copies it straight
# from wherever you're running ansible-playbook to the target VM -- no
# Hugging Face download, no internet needed on the target for this step.
# Leave unset/empty to fall back to fetch-model.sh downloading on the target.
# model_local_path: "/home/you/models/muse-glimmer.Q5_K_M.gguf"

audit_root: /srv/ainode/audit
scratch_root: /srv/ainode/scratch
backup_root: /srv/ainode/backup
